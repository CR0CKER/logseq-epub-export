{
  "name": "logseq-epub-export",
  "author": "CR0CKER",
  "description": "Export a Logseq graph to a navigable EPUB for reading on e-ink devices (KOReader, etc.).",
  "version": "0.1.0",
  "main": "dist/index.html",
  "effect": true,
  "homepage": "https://github.com/CR0CKER/logseq-epub-export",
  "repository": {
    "type": "git",
    "url": "https://github.com/CR0CKER/logseq-epub-export.git"
  },
  "bugs": {
    "url": "https://github.com/CR0CKER/logseq-epub-export/issues"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "epub",
    "export",
    "koreader",
    "e-ink",
    "ereader"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-unit.mjs",
    "preview:cover": "esbuild tests/cover-preview.ts --bundle --outfile=docs/cover-preview.js",
    "test:live": "npm run build && node tests/live/run.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "^0.3.4",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vite-plugin-logseq": "^1.1.2"
  },
  "logseq": {
    "id": "logseq-epub-export",
    "title": "EPUB Export",
    "icon": "./icon.png"
  },
  "overrides": {
    "dompurify": "^3.4.15",
    "lodash-es": "^4.18.1"
  }
}
